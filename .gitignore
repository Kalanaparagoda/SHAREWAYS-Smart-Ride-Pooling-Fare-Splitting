# ========================
# ShareWays — Root .gitignore
# ========================

# Environment & secrets — NEVER commit these
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
serviceAccountKey.json
*serviceAccount*.json
*.pem
*.key

# Editor / OS
.DS_Store
.DS_Store?
Thumbs.db
*.swp
*.swo
.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build & Dependencies (GB ගණන් ලොකු folders)
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.cache/
.firebase/
frontend/.firebase/

# Python Virtual Environments
venv/
**/venv/
__pycache__/
**/__pycache__/
.pytest_cache/